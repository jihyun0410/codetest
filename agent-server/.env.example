# ============================================================================
#  Agent Server 환경변수 예시 — 실제 값은 .env 로 복사 후 입력 (git 커밋 금지)
# ============================================================================

# --- 서버 ---
CODETEST_APP_NAME="Code Test AI Agent"
CODETEST_HOST=0.0.0.0
CODETEST_PORT=8000
# Local Client 가 X-API-Key 헤더로 보내야 하는 값 (쉼표로 복수 허용).
# 비워 두면 인증이 비활성화된다 — 로컬 개발에서만 그렇게 쓸 것.
CODETEST_API_KEYS=local-dev-key

# --- DB ---
# 기본값은 SQLite. 운영 시 postgresql+psycopg://user:pw@host/db 로 교체
CODETEST_DATABASE_URL=sqlite:///./data/codetest.db

# --- 작업 디렉터리 (대상 저장소 clone 위치) ---
CODETEST_WORKSPACE_DIR=./workspace

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
CODETEST_LLM_MODEL=claude-opus-5
CODETEST_LLM_EFFORT=high
CODETEST_LLM_MAX_TOKENS=32000
