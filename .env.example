# ============================================================================
#  Agent 환경변수 예시 — 실제 값은 .env 로 복사 후 입력 (git 커밋 금지)
#  Agent 는 LLM 판단만 담당한다. DB/작업 디렉터리 설정은 MCP 쪽에 있다.
# ============================================================================

# --- 서버 ---
CODETEST_APP_NAME="Code Test AI Agent"
CODETEST_HOST=0.0.0.0
CODETEST_PORT=8000
# Local Client 가 X-API-Key 헤더로 보내야 하는 값 (쉼표로 복수 허용).
# 비워 두면 인증이 비활성화된다 — 로컬 개발에서만 그렇게 쓸 것.
CODETEST_API_KEYS=local-dev-key

# --- MCP 서비스 (코드 기반 처리 위임 대상) ---
CODETEST_MCP_BASE_URL=http://localhost:8100
CODETEST_MCP_API_KEY=
CODETEST_MCP_TIMEOUT=120
# Gradle 빌드 + Spring 컨텍스트 기동 시간을 감안한다
CODETEST_MCP_EXECUTE_TIMEOUT=960

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
CODETEST_LLM_MODEL=claude-opus-5
CODETEST_LLM_EFFORT=high
CODETEST_LLM_MAX_TOKENS=32000
