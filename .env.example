# ============================================================================
#  Agent 환경변수 예시 — 실제 값은 .env 로 복사 후 입력 (git 커밋 금지)
#  Agent 는 LLM 판단만 담당한다. Agent 를 호출하는 쪽은 MCP 다 —
#  DB·작업 디렉터리·MCP 주소 설정은 전부 MCP(codetest-mcp) 쪽에 있다.
# ============================================================================

# --- 서버 ---
CODETEST_APP_NAME="Code Test AI Agent"
CODETEST_HOST=0.0.0.0
CODETEST_PORT=8000
# Local Client 가 X-API-Key 헤더로 보내야 하는 값 (쉼표로 복수 허용).
# 비워 두면 인증이 비활성화된다 — 로컬 개발에서만 그렇게 쓸 것.
CODETEST_API_KEYS=local-dev-key

# --- LLM (OpenAI) ---
# OpenAI 호환 엔드포인트 주소. 비우면 https://api.openai.com/v1
# 같은 Docker 네트워크에서 돌 때는 서비스명, 로컬 uvicorn 이면 http://localhost:4000/v1
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-proj-...
CODETEST_LLM_MODEL=gpt-5
CODETEST_LLM_EFFORT=high
CODETEST_LLM_MAX_TOKENS=32000
